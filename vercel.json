{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/restaurants",
      "destination": "/"
    },
    {
      "source": "/restaurant",
      "destination": "/"
    },
    {
      "source": "/city/delhi/:path*",
      "destination": "/"
    },
    {
      "source": "/Checkout",
      "destination": "/"
    }
  ]
}
